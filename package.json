{
  "name": "stocksense",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered inventory forecasting for kirana stores",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:server": "turbo run dev --filter=@stocksense/server",
    "dev:client": "turbo run dev --filter=@stocksense/client",
    "build:server": "turbo run build --filter=@stocksense/server",
    "build:client": "turbo run build --filter=@stocksense/client"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
